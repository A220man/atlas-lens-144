    {
      "name": "vue-volar",
      "description": "Vue.js Language Server Protocol support via Volar (@vue/language-server)",
      "author": "Anthropic",
      "source": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/vue-volar",
      "category": "lsp",
      "tags": ["vue", "vue3", "volar", "lsp", "typescript"],
      "lspServers": {
        "vue": {
          "command": "vue-language-server",
          "args": ["--stdio"],
          "extensionToLanguage": {

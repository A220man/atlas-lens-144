{
  "plugins": [
    {
      "name": "typescript-lsp",
      "description": "TypeScript/JavaScript Language Server Protocol support via typescript-language-server",
      "author": "Anthropic",
      "source": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/typescript-lsp",
      "category": "lsp",
      "tags": ["typescript", "javascript", "lsp"],
      "lspServers": {
        "typescript": {
          "command": "typescript-language-server",
          "args": ["--stdio"],
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".js": "javascript",
            ".jsx": "javascriptreact"
          },
          "transport": "stdio"
        }
      }
    },
    {
      "name": "pyright-lsp",
      "description": "Python Language Server Protocol support via Pyright",
      "author": "Anthropic",
      "source": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/pyright-lsp",
      "category": "lsp",
      "tags": ["python", "lsp"],
      "lspServers": {
        "pyright": {
          "command": "pyright-langserver",
          "args": ["--stdio"],
          "extensionToLanguage": {
            ".py": "python"
          },
          "transport": "stdio"
        }
      }
    },
    {
      "name": "gopls-lsp",
      "description": "Go Language Server Protocol support via gopls",
      "author": "Anthropic",
      "source": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/gopls-lsp",
      "category": "lsp",
      "tags": ["go", "golang", "lsp"],
      "lspServers": {
        "gopls": {
          "command": "gopls",
          "args": ["serve"],
          "extensionToLanguage": {
            ".go": "go"
          },
          "transport": "stdio"
        }
      }
    },
    {
      "name": "rust-analyzer-lsp",
      "description": "Rust Language Server Protocol support via rust-analyzer",
      "author": "Anthropic",
      "source": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/rust-analyzer-lsp",
      "category": "lsp",
      "tags": ["rust", "lsp"],
      "lspServers": {
        "rust-analyzer": {
          "command": "rust-analyzer",
          "args": [],
          "extensionToLanguage": {
            ".rs": "rust"
          },
          "transport": "stdio"
        }
      }
    },
    {
      "name": "clangd-lsp",
      "description": "C/C++ Language Server Protocol support via clangd",
      "author": "Anthropic",
      "source": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/clangd-lsp",
      "category": "lsp",
      "tags": ["c", "cpp", "c++", "lsp"],
      "lspServers": {
        "clangd": {
          "command": "clangd",
          "args": [],
          "extensionToLanguage": {
            ".c": "c",
            ".cpp": "cpp",
            ".cc": "cpp",
            ".cxx": "cpp",
            ".h": "c",
            ".hpp": "cpp"
          },
          "transport": "stdio"
        }
      }
    },
    {
      "name": "php-lsp",
      "description": "PHP Language Server Protocol support via phpactor",
      "author": "Anthropic",
      "source": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/php-lsp",
      "category": "lsp",
      "tags": ["php", "lsp"],
      "lspServers": {
        "phpactor": {
          "command": "phpactor",
          "args": ["language-server"],
          "extensionToLanguage": {
            ".php": "php"
          },
          "transport": "stdio"
        }
      }
    },
    {
      "name": "swift-lsp",
